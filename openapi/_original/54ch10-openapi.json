    "/v1/hash": {
      "get": {
        "operationId": "getHash",
        "summary": "Hash data (sha256|sha1|md5)",
        "description": "Hash UTF-8 data. Query algo=&q=. Also accepts POST JSON {algo,data}. Unauthenticated → HTTP 402 (USDC $0.001). Demo free: X-54ch10-Free: 1 or /free sibling.",
