    "/v1/open": {
      "get": {
        "operationId": "getOpen",
        "summary": "Open URL (brief + whois + page + page_risk)",
        "description": "One paid call before opening a URL: URL brief + WHOIS domain + SSRF-safe page fetch, plus page_risk content flags and up to 3 one-hop off-host fetches (see page_risk.hops). Query q= or url=. Unauthenticated GET (including missing q) → HTTP 402 + PAYMENT-REQUIRED (USDC $0.015). Params validated after payment. Demo free: X-54ch10-Free: 1 or /free sibling.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Public http(s) URL to open"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Alias for q"
          },
          {
            "$ref": "#/components/parameters/X54ch10Free"
          },
          {
            "$ref": "#/components/parameters/PaymentSignature"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON {ok,q,url,brief,domain,page,page_risk,tier,disclaimer}. page_risk includes flags, scoreDelta, optional hops[]. Partial success if page fetch fails."
          },
          "400": {
            "description": "q is not a valid http(s) URL (after payment / free / Bearer)"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Payment Required (x402). Decode PAYMENT-REQUIRED for accepts[] and extensions.bazaar.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
