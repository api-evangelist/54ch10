    "/v1/open/batch": {
      "post": {
        "operationId": "postOpenBatch",
        "summary": "Bulk open (paid-only, cap 25)",
        "description": "Bulk URL checks — same open-class brief per URL. Body: { \"urls\": [\"https://…\"] } (aliases: q, urls_text). Cap 25. Paid-only: stack debit N credits or x402 N×$0.015 USDC on Base. Unauthenticated → HTTP 402 + PAYMENT-REQUIRED. No free tier. Human checkout: https://linksafu.com/bulk (Check bulk →).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "urls"
                ],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 25,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "description": "HTTP(S) URLs to open (1–25). Duplicates dropped."
                  },
                  "q": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Alias for urls"
                  },
                  "urls_text": {
                    "type": "string",
                    "description": "Newline/comma-separated URL list alias"
                  }
                }
              },
              "example": {
                "urls": [
                  "https://example.com",
                  "https://example.org"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentSignature"
          },
          {
            "name": "X-54ch10-Stack",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Prepaid stack id (debits N credits)"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON {ok, count, cap, results[], tier, disclaimer}. Each result is open-class or {ok:false,error,code}."
          },
          "400": {
            "description": "empty_urls / batch_cap / bad_json (after payment / stack / Bearer)"
          },
          "401": {
            "description": "Invalid API key"
          },
          "402": {
            "description": "Payment Required (x402). Decode PAYMENT-REQUIRED for accepts[] and extensions.bazaar. Price = N×$0.015.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "batch_busy — global concurrency full; retry shortly"
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ]
      }
    },
