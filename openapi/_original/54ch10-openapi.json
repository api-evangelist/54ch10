                    "type": "boolean"
                  },
                  "bounce_reason": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "looking_for": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "feature_request": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "would_pay_for": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "contact": {
                    "type": "string",
                    "maxLength": 320
                  },
                  "reply_ok": {
                    "type": "boolean"
                  },
                  "channel": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
