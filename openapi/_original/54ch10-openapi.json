    "/v1/stack": {
      "get": {
        "operationId": "getStack",
        "summary": "Buy prepaid stack pack or read remaining",
        "description": "Bare GET or pack=1 → HTTP 402 (USDC $1.00 → 80 credits, 7-day TTL). pack=5 → $5/500/30d; pack=25 → $25/3000/90d; pack=100 → $100/15000/180d. Invalid pack → 400 before settle. GET ?id= returns remaining (no extra charge). Then send X-54ch10-Stack: <id>. Unused credits expire. NOT a vault. Not refundable.",
        "parameters": [
          {
            "name": "pack",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "5",
                "25",
                "100"
              ]
            },
            "description": "Prepaid pack size (default 1)"
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alias for pack (1|5|25|100)"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Stack id for remaining lookup"
          },
          {
            "$ref": "#/components/parameters/PaymentSignature"
          }
        ],
        "responses": {
          "200": {
            "description": "{ok,pack,paid_usd,credits,ttl_days,header,expires,note} or remaining"
          },
          "400": {
            "description": "Invalid pack"
          },
          "402": {
            "description": "Payment Required (x402 exact per pack)"
          },
          "404": {
            "description": "Unknown or expired stack id"
          }
        }
      },
      "post": {
        "operationId": "postStack",
        "summary": "Buy prepaid stack pack",
        "description": "x402 exact per pack (default $1.00 → 80 credits / 7d). Query pack= or amount=. Unused credits expire. Wallet-bound. NOT a vault. Not refundable.",
        "parameters": [
          {
            "name": "pack",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "5",
                "25",
                "100"
              ]
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/PaymentSignature"
          }
        ],
        "responses": {
          "200": {
            "description": "{ok,pack,paid_usd,credits,ttl_days,header,expires,note}"
          },
          "400": {
            "description": "Invalid pack"
          },
          "402": {
            "description": "Payment Required"
          }
        }
      }
    },
